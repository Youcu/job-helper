# Environments
.env
.env.*
.venv

# 편집기 임시 파일 — .env 를 열면 값이 그대로 담긴 스왑본이 남는다
*.swp
*.swo
*~
.DS_Store

**/__pycache__/
*.py[cod]

# 커버리지 측정 산출물 — 돌릴 때마다 새로 생긴다
.coverage
htmlcov/

# Agent Context Logs
**/context/

# Docs
# 루트 docs 만 추적한다. 각 파이프라인 단계의 docs 는 그 단계를 만들어 가는
# 중간 확인용이라 완제품을 쓰는 사람에게는 쓸모가 없다.
**/docs/
!/docs/

# 수집 산출물
# 사람마다 스크랩 대상이 다르다. 남의 조건으로 뽑은 CSV 를 받을 이유가 없다.
**/csv/

# 이미지 판독 캐시 · 코퍼스 후보
# 캐시는 다시 만들면 되고, 후보는 사람이 보고 사전으로 옮기면 사라지는 중간물이다.
**/cache/
corpus_candidates.json
corpus_candidates.csv

# Playwright MCP 가 남기는 화면 로그·스냅샷. 도구 산출물이라 다시 만들면 된다.
.playwright-mcp/

# 손에 익은 개인 스크립트. 저장소가 돌아가는 데 필요하지 않다.
clear_csv.sh
